DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('DimProductCategory'[EnglishProductCategoryName])),
			AND(
				NOT(ISBLANK('DimProductCategory'[EnglishProductCategoryName])),
				NOT('DimProductCategory'[EnglishProductCategoryName] IN {BLANK()})
			)
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('DimGeography'[EnglishCountryRegionName])),
			NOT('DimGeography'[EnglishCountryRegionName] IN {BLANK(),
				"Australia"})
		)

	VAR __ValueFilterDM1 = 
		FILTER(
			KEEPFILTERS(
				SUMMARIZECOLUMNS(
					'DimProductCategory'[EnglishProductCategoryName],
					__DS0FilterTable,
					__DS0FilterTable2,
					"Total_Sales", '_Measures'[Total Sales],
					"Total_Sales__All_", '_Measures'[Total Sales (All)],
					"Total_Sales__All_Selected_", '_Measures'[Total Sales (All Selected)],
					"Total_Sales__All_Except_", '_Measures'[Total Sales (All Except)]
				)
			),
			[Total_Sales] > CURRENCY("0")
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('DimProductCategory'[EnglishProductCategoryName], "IsGrandTotalRowTotal"),
			__DS0FilterTable,
			__DS0FilterTable2,
			__ValueFilterDM1,
			"Total_Sales", '_Measures'[Total Sales],
			"Total_Sales__All_", '_Measures'[Total Sales (All)],
			"Total_Sales__All_Selected_", '_Measures'[Total Sales (All Selected)],
			"Total_Sales__All_Except_", '_Measures'[Total Sales (All Except)]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'DimProductCategory'[EnglishProductCategoryName],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'DimProductCategory'[EnglishProductCategoryName]