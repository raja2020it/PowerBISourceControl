		lineageTag: 54d530fa-168a-435b-9f9b-e6e67439f8d3

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Profit' = [Total Sales]-[Total Cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c3eb9f81-da1d-457d-8369-2c6dbfeb1b6f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Profit Margin %' = DIVIDE([Total Profit],[Total Sales])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 39852494-7a02-41cb-8545-943d864d96e7

	measure 'Average Selling Price' = DIVIDE([Total Sales],[Total Quantity])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b52c29ff-4266-4527-9d04-7f244d4f7d74

	measure 'Total orders' = DISTINCTCOUNT ( FactInternetSales[SalesOrderNumber] )
		formatString: 0
		lineageTag: f0dcfa2a-0180-4f57-a36d-e58d8e6af04f

	measure 'Total customers' = DISTINCTCOUNT(FactInternetSales[CustomerKey])
		formatString: 0
		lineageTag: 722fb254-d70c-4dbf-953d-382aae50b517

	measure 'Average order value' = DIVIDE([Total Sales],[Total orders])
