table _Measures
	lineageTag: ac18de3c-2cf7-4c2a-b11f-418340c0e04d

	measure 'Total Sales' = SUM('FactInternetSales'[SalesAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4a992741-ad25-4bdc-8aab-e4952ad8b6c7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Cost' = SUMX('FactInternetSales',FactInternetSales[OrderQuantity] * FactInternetSales[UnitPrice])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8ca5750e-22af-4b70-aac4-31b279193c7c

	measure 'Total Quantity' = SUM(FactInternetSales[OrderQuantity])
		formatString: 0
		lineageTag: ec62842a-0365-4fa7-b8a0-5fe90458cda2

	measure 'Total TAX' = SUM(FactInternetSales[TaxAmt])
