		lineageTag: 4a6f542b-bc3c-4ea0-9ac8-f6109ec5ae30

	measure 'Orders per Customer' = DIVIDE([Total orders],[Total customers])
		lineageTag: b03f3c9d-fed9-400d-8bb2-5afb10c8c674

		annotation PBI_FormatHint = {"isGeneralNumber":true}

