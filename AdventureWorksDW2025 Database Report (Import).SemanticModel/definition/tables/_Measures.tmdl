	measure 'Total Sales (MoM %)' = ```
			DIVIDE([total sales] - [Total Sales (Previous Month)],[Total Sales (Previous Month)]) 
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02. TIME INTELLIGENT MEASURES
		lineageTag: 83f22655-a64b-4408-b619-1f8d92584fef

	measure 'Total Sales (Rolling 3 Month Avg.)' = ```
			
			        AVERAGEX(
			    DATESINPERIOD(
			        DimDate[FullDateAlternateKey],
			        MAX(DimDate[FullDateAlternateKey]),
			        -3,
			        MONTH
			    ),
			    [TOTAL SALES]
			)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 02. TIME INTELLIGENT MEASURES
		lineageTag: 15aaf5d3-190c-49d2-a410-cf8629469235

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Sales (Rolling 12 Months)' = CALCULATE([TOTAL SALES],DATESINPERIOD(DimDate[FullDateAlternateKey],MAX(DimDate[FullDateAlternateKey]),-12,MONTH))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 02. TIME INTELLIGENT MEASURES
		lineageTag: 6d1418ed-a769-4e64-87b6-ab4d63ba4648

